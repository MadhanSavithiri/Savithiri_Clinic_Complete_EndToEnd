# Copy to .env (scripts\windows\init_env.ps1 does this for you). NEVER share or commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Every address/name browsers will use to reach the server, comma separated:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
# 0.0.0.0 = listen on the LAN. Use 127.0.0.1 for same-computer-only testing.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_THREADS=8
# Change from "admin" to make the admin URL less guessable (letters/digits/dash only)
ADMIN_URL=admin
DB_ENGINE=postgres
DB_NAME=clinic_db
DB_USER=clinic_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
SESSION_TIMEOUT_MINUTES=15
# Keep False while using plain http:// on the LAN (Secure cookies are not sent over http)
SESSION_COOKIE_SECURE=False
